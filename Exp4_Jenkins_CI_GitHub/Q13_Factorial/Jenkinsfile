pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/<your-username>/factorial-ci.git'
            }
        }
        stage('Compile') {
            steps {
                sh 'javac Factorial.java'
            }
        }
        stage('Execute') {
            steps {
                sh 'echo "5" | java Factorial'
            }
        }
    }
    post {
        success {
            echo 'Build and execution successful'
        }
        failure {
            echo 'Build failed'
        }
    }
}
