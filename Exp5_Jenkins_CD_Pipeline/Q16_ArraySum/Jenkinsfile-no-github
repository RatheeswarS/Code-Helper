pipeline {
    agent any

    environment {
        APP_NAME   = 'ArraySum'
        JAR_NAME   = 'ArraySum.jar'
        DEPLOY_DIR = '/var/lib/jenkins/deployments/array-sum'
    }

    stages {
        stage('Get Source') {
            steps {
                writeFile file: 'ArraySum.java', text: '''import java.util.Scanner;

public class ArraySum {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[5];
        int sum = 0;
        System.out.println("Enter 5 integers:");
        for (int i = 0; i < 5; i++) {
            arr[i] = sc.nextInt();
            sum = sum + arr[i];
        }
        System.out.print("Array elements: ");
        for (int x : arr) {
            System.out.print(x + " ");
        }
        System.out.println();
        System.out.println("Sum of array elements = " + sum);
        sc.close();
    }
}
'''
            }
        }
        stage('Build') {
            steps {
                sh 'rm -rf build && mkdir -p build'
                sh 'javac -d build ${APP_NAME}.java'
            }
        }
        stage('Package') {
            steps {
                // jar c=create f=file e=entry point(Main-Class)
                sh 'jar cfe ${JAR_NAME} ${APP_NAME} -C build .'
                archiveArtifacts artifacts: "${JAR_NAME}", fingerprint: true
            }
        }
        stage('Deploy') {
            steps {
                sh 'mkdir -p ${DEPLOY_DIR}'
                sh 'cp ${JAR_NAME} ${DEPLOY_DIR}/'
                sh 'ls -l ${DEPLOY_DIR}'
            }
        }
        stage('Execute & Verify') {
            steps {
                sh 'cd ${DEPLOY_DIR} && echo "10 20 30 40 50" | java -jar ${JAR_NAME} | tee output.txt'
                sh 'grep -q "Sum of array elements = 150" ${DEPLOY_DIR}/output.txt && echo "VERIFIED: deployed application ran correctly"'
            }
        }
    }
    post {
        success {
            echo "Deployed to ${DEPLOY_DIR}/${JAR_NAME}"
        }
        failure {
            echo 'CD pipeline failed'
        }
    }
}
